<?xml version="1.0"?>
<ruleset name="CHIP for GiveWP">
	<description>PHPCS ruleset for CHIP for GiveWP plugin.</description>

	<!-- What to scan -->
	<file>.</file>

	<!-- Only scan PHP files -->
	<arg name="extensions" value="php"/>

	<!-- Exclude paths -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/*</exclude-pattern>
	<exclude-pattern>/resources/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<!-- Use WordPress coding standards -->
	<rule ref="WordPress">
	</rule>

	<!-- Set minimum supported PHP version -->
	<config name="minimum_supported_wp_version" value="6.3"/>
	<config name="testVersion" value="7.4-8.5"/>

	<!-- Text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="chip-for-givewp"/>
			</property>
		</properties>
	</rule>

	<!-- Main plugin entry point cannot be renamed to class-chip-givewp.php. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>chip-for-givewp.php</exclude-pattern>
		<exclude-pattern>uninstall.php</exclude-pattern>
	</rule>

	<!-- WordPress pseudo-singleton pattern uses $instance (not $_instance). -->
	<rule ref="PSR2.Classes.PropertyDeclaration">
		<exclude name="PSR2.Classes.PropertyDeclaration.Underscore"/>
	</rule>

	<!-- GiveWP 3.0 PaymentGateway interface mandates camelCase parameter names. -->
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<exclude-pattern>includes/block/class-chipgateway.php</exclude-pattern>
	</rule>

	<!-- Webhook callbacks do not use WordPress nonces (verified via signature). -->
	<rule ref="WordPress.Security.NonceVerification">
		<exclude-pattern>includes/class-chip-givewp-listener.php</exclude-pattern>
	</rule>

	<!-- base64_decode is used for legitimate webhook signature verification. -->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions">
		<exclude-pattern>includes/class-chip-givewp-listener.php</exclude-pattern>
	</rule>

	<!-- GiveWP registered capabilities. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_give_payments"/>
			</property>
		</properties>
	</rule>

</ruleset>
